#!/bin/bash
# Rofi Wi-Fi picker on top of nmcli (replaces nm-applet's menu)

set -uo pipefail

rofi_menu() { rofi -dmenu -i -p "$1" "${@:2}"; }

state=$(nmcli -t -f WIFI radio)
if [[ $state != enabled ]]; then
    choice=$(printf '󰖩  Turn Wi-Fi on\n󰒓  Network settings\n' | rofi_menu "Wi-Fi off") || exit 0
    case $choice in
        *"Turn Wi-Fi on") nmcli radio wifi on ;;
        *settings) nm-connection-editor & ;;
    esac
    exit 0
fi

notify-send -t 1500 "Wi-Fi" "Scanning…" 2>/dev/null || true
# IN-USE:SIGNAL:SECURITY:SSID (SSID last so ':' in names is harmless)
mapfile -t nets < <(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan auto |
    awk -F: '$4 != "" && !seen[$4]++')

icon() { (( $1 > 75 )) && echo 󰤨 || { (( $1 > 50 )) && echo 󰤥; } || { (( $1 > 25 )) && echo 󰤢; } || echo 󰤟; }
lines=()
for n in "${nets[@]}"; do
    IFS=: read -r inuse signal security ssid <<<"$n"
    ssid=${n#*:*:*:}
    mark=" "; [[ $inuse == "*" ]] && mark="✓"
    lock=""; [[ -n $security && $security != "--" ]] && lock=" 󰌾"
    lines+=("$mark $(icon "$signal")  $ssid$lock")
done
lines+=("  󰖪  Turn Wi-Fi off" "  󰒓  Network settings")

choice=$(printf '%s\n' "${lines[@]}" | rofi_menu "Wi-Fi") || exit 0
case $choice in
    *"Turn Wi-Fi off") nmcli radio wifi off; exit 0 ;;
    *"Network settings") nm-connection-editor & exit 0 ;;
esac

ssid=$(sed -E 's/^. [^ ]+  //; s/ 󰌾$//' <<<"$choice")
if nmcli -t -f NAME con show | grep -Fxq "$ssid"; then
    nmcli con up id "$ssid" && notify-send "Wi-Fi" "Connected to $ssid"
elif printf '%s\n' "${nets[@]}" | grep -F ":$ssid" | grep -q 802.1X; then
    # Enterprise (eduroam-style) logins need more than a password
    nm-connection-editor --create --type=802-11-wireless &
elif [[ $choice == *󰌾 ]]; then
    pass=$(rofi -dmenu -password -p "Password for $ssid" -lines 0) || exit 0
    nmcli dev wifi connect "$ssid" password "$pass" && notify-send "Wi-Fi" "Connected to $ssid"
else
    nmcli dev wifi connect "$ssid" && notify-send "Wi-Fi" "Connected to $ssid"
fi
