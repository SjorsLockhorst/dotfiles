#!/bin/bash
# Switch the desktop theme live: render it, swap it in, reload running apps.
#
# Usage: theme-set <name>      switch to a theme (see theme-list)
#        theme-set --refresh   re-render the current theme (after editing templates)
#
# Themes are looked up in, in order:
#   ~/.config/theme/themes       your own themes (trusted, chezmoi-managed)
#   ~/.local/share/theme/installed  community themes from theme-install (colours only)
#   ~/.local/share/theme/themes  official omarchy themes (trusted, chezmoi external)

set -euo pipefail

STATE="$HOME/.local/state/theme"
CURRENT="$STATE/current"
DEFAULT_THEME="catppuccin"

theme_dir() {
    local dir
    for dir in "$HOME/.config/theme/themes" "$HOME/.local/share/theme/installed" "$HOME/.local/share/theme/themes"; do
        [[ -f "$dir/$1/colors.toml" ]] && { echo "$dir/$1"; return; }
    done
    return 1
}

if [[ ${1:-} == "--refresh" ]]; then
    name=$(cat "$STATE/name" 2>/dev/null || echo "$DEFAULT_THEME")
elif [[ -n ${1:-} ]]; then
    name="$1"
else
    echo "Usage: theme-set <name> | --refresh" >&2
    exit 1
fi

src=$(theme_dir "$name") || { echo "theme-set: unknown theme '$name' (see theme-list)" >&2; exit 1; }
untrusted=()
[[ $src == "$HOME/.local/share/theme/installed/"* ]] && untrusted=(--untrusted)

# Render into a fresh directory, then repoint the symlink in one step so apps
# never see a half-written theme
mkdir -p "$STATE"
gen="$STATE/gen-$(date +%s%N)"
"$(dirname "$0")/theme-render" "$src" "$gen" "${untrusted[@]}"
# Wallpapers: the theme's own, plus yours: the ones directly in
# ~/.config/theme/backgrounds (for every theme) and those in its <theme>/
# subfolder. Yours win on a name clash and are the default if there's no saved pick.
# theme-bg-next cycles through them and remembers the choice per theme.
own=("$HOME/.config/theme/backgrounds" "$HOME/.config/theme/backgrounds/$name")
images() { [[ -d $1 ]] && find -L "$1" -maxdepth 1 -type f -iregex '.*\.\(jpe?g\|png\|webp\)' | sort; }
mkdir "$gen/backgrounds"
for dir in "$src/backgrounds" "${own[@]}"; do
    while IFS= read -r f; do
        ln -sfn "$f" "$gen/backgrounds/$(basename "$f")"
    done < <(images "$dir" || true)
done
saved=$(cat "$STATE/backgrounds/$name" 2>/dev/null || true)
if [[ -n $saved && -e "$gen/backgrounds/$saved" ]]; then
    bg="$gen/backgrounds/$saved"
else
    bg=$( { images "${own[1]}"; images "${own[0]}"; images "$gen/backgrounds"; } 2>/dev/null | head -1 || true)
fi
if [[ -n $bg ]]; then ln -s "$(readlink -f "$bg")" "$gen/background"; fi
ln -sfn "$gen" "$STATE/current.new"
mv -T "$STATE/current.new" "$CURRENT"
echo "$name" >"$STATE/name"
find "$STATE" -maxdepth 1 -name 'gen-*' ! -path "$gen" -exec rm -rf {} +

mode=$(cat "$CURRENT/mode")

# Reload what's running. Each step is best-effort: a missing app is skipped.
pkill -USR1 -x kitty 2>/dev/null || true
pkill -USR2 -x waybar 2>/dev/null || true
pkill -USR2 -x btop 2>/dev/null || true
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null 2>&1 || true
    [[ -e "$CURRENT/background" ]] &&
        hyprctl hyprpaper wallpaper ",$(readlink -f "$CURRENT/background")" >/dev/null 2>&1 || true
fi

# tmux: the catppuccin plugin bakes colours in when sourced, so re-source
tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true

# GTK: Adwaita follows the theme's mode, so does libadwaita via color-scheme
# Icons: the theme's own icon set (Yaru-<colour>) if installed, otherwise Papirus
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gsettings >/dev/null; then
    if [[ $mode == light ]]; then
        gsettings set org.gnome.desktop.interface color-scheme prefer-light
        gsettings set org.gnome.desktop.interface gtk-theme Adwaita
        icons=Papirus-Light
    else
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark
        gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
        icons=Papirus-Dark
    fi
    wanted=$(tr -d '[:space:]' <"$CURRENT/icons.theme" 2>/dev/null || true)
    if [[ -n $wanted && ( -d /usr/share/icons/$wanted || -d $HOME/.local/share/icons/$wanted ) ]]; then
        icons=$wanted
    fi
    gsettings set org.gnome.desktop.interface icon-theme "$icons"
fi

for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*.0; do
    [[ -S $sock ]] && timeout 2 nvim --server "$sock" --remote-expr 'v:lua.ThemeReload()' >/dev/null 2>&1 &
done
wait

echo "Theme: $name ($mode)"
