#!/usr/bin/env python3
"""Render a theme's colors.toml through the app templates into a directory.

Usage: theme-render <theme-dir> <out-dir> [--untrusted]

Themes use omarchy's format (themes/<name>/colors.toml plus optional extras),
so the official omarchy themes and community themes work unchanged. Template
syntax follows omarchy's too: {{ key }}, {{ key_strip }}, {{ key_rgb }},
{{ mix[_strip|_rgb] a b 20% }} and {{ hypr_gradient key fallback }}.
"""

import os
import re
import shutil
import sys
import tomllib
from pathlib import Path

TEMPLATE_DIR = Path(os.environ.get("THEME_TEMPLATES", Path.home() / ".config/theme/templates"))

# Files a theme may ship to replace the rendered template. Untrusted
# (community) themes only get the colour-only ones: anything Lua or a terminal
# config can run code.
TRUSTED_OVERRIDES = {"btop.theme", "neovim.lua"}
UNTRUSTED_OVERRIDES = {"btop.theme"}
HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")
SAFE_TOKEN = re.compile(r"#[0-9A-Fa-f]{3,8}|rgba?\([0-9A-Fa-f., %]+\)|-?\d+(\.\d+)?(deg)?|[A-Za-z_-]+")


def parse_colors(path):
    text = path.read_text()
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        # Some community themes aren't valid TOML; fall back to key = "value" lines
        data = {}
        for line in text.splitlines():
            m = re.match(r'^\s*([A-Za-z0-9_-]+)\s*=\s*["\']?([^"\'#]*)', line)
            if m:
                data[m.group(1)] = m.group(2).strip()
    # Values are pasted into shell, Lua and tmux files, so only accept things that
    # look like colours (or a gradient of them, or a bare word like "dark").
    # Anything else could break out of the quotes and run code.
    colors = {}
    for key, value in data.items():
        value = str(value).strip()
        if all(SAFE_TOKEN.fullmatch(t) for t in value.split()):
            colors[key] = value
        else:
            print(f"theme-render: ignoring {key}: not a colour", file=sys.stderr)
    return colors


def mix(a, b, amount):
    if not (HEX.match(a) and HEX.match(b)):
        return a  # can't mix rgba()/gradients; keep the first colour
    amount = str(amount)
    amount = float(amount[:-1]) / 100 if amount.endswith("%") else float(amount)
    if amount > 1:
        amount /= 100
    amount = min(max(amount, 0), 1)
    ca = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(int(x * (1 - amount) + y * amount + 0.5) for x, y in zip(ca, cb))


def resolve(c):
    """Fill in missing slots the same way omarchy-theme-color does."""
    def alias(key, fallback):
        if not c.get(key) and c.get(fallback):
            c[key] = c[fallback]

    short = {"background": "bg", "dark_background": "dark_bg", "darker_background": "darker_bg",
             "lighter_background": "lighter_bg", "foreground": "fg", "dark_foreground": "dark_fg",
             "light_foreground": "light_fg", "bright_foreground": "bright_fg"}
    for key, fallback in short.items():
        alias(key, fallback)

    alias("background", "color0")
    alias("foreground", "color7")
    if c.get("background"):
        c["color0"] = c["background"]
    if c.get("foreground"):
        c["color7"] = c["foreground"]

    for key, n in [("red", 1), ("green", 2), ("yellow", 3), ("blue", 4), ("magenta", 5), ("cyan", 6),
                   ("bright_red", 9), ("bright_green", 10), ("bright_yellow", 11), ("bright_blue", 12),
                   ("bright_magenta", 13), ("bright_cyan", 14)]:
        alias(key, f"color{n}")
    alias("magenta", "purple")
    alias("bright_magenta", "bright_purple")

    # A broken or minimal theme still renders: missing basics fall back
    c.setdefault("background", "#000000")
    c.setdefault("foreground", "#ffffff")
    for base in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        c.setdefault(base, c["foreground"])
    c.setdefault("accent", c["blue"])

    c.setdefault("light_foreground", c.get("color7") or c["foreground"])
    c.setdefault("bright_foreground", c.get("color15") or c["foreground"])
    c["cursor"] = c["bright_foreground"]
    c.setdefault("lighter_background", c.get("color0") or c["background"])
    c.setdefault("dark_foreground", c.get("color8") or c["foreground"])
    c.setdefault("muted", c.get("color8") or c["dark_foreground"])
    c.setdefault("selection", c.get("selection_background") or c.get("color8") or c["background"])
    c.setdefault("selection_background", c["selection"])
    c.setdefault("selection_foreground", c["bright_foreground"])
    c.setdefault("orange", c["yellow"])
    c.setdefault("brown", mix(c["orange"], "#000000", "50%"))
    c.setdefault("dark_background", mix(c["background"], "#000000", "25%"))
    c.setdefault("darker_background", mix(c["background"], "#000000", "50%"))
    for base in ("red", "yellow", "green", "cyan", "blue", "magenta"):
        c.setdefault(f"bright_{base}", mix(c[base], "#ffffff", "20%"))
    alias("purple", "magenta")
    alias("bright_purple", "bright_magenta")

    for n, key in enumerate(["background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground",
                             "muted", "bright_red", "bright_green", "bright_yellow", "bright_blue",
                             "bright_magenta", "bright_cyan", "bright_foreground"]):
        alias(f"color{n}", key)
    for key, fallback in short.items():
        c[fallback] = c[key]

    if not c.get("mode"):
        c["mode"] = c.get("theme_type") or (
            "light" if HEX.match(c["background"]) and sum(int(c["background"][i:i + 2], 16) for i in (1, 3, 5)) > 382
            else "dark")
    c["theme_type"] = c["mode"]
    return c


def hypr_gradient(c, key, fallback):
    spec = c.get(key) or c.get(fallback) or fallback
    colors, angle = [], None
    for part in spec.split():
        if re.fullmatch(r"-?\d+(\.\d+)?deg", part):
            angle = part[:-3]
        else:
            colors.append(c.get(part, part))
    if len(colors) <= 1:
        return '"%s"' % (colors[0] if colors else spec)
    value = "{ colors = { %s }" % ", ".join('"%s"' % x for x in colors)
    return value + (f", angle = {angle} }}" if angle else " }")


def render(text, c):
    def sub(m):
        parts = m.group(1).split()
        if len(parts) == 1:
            key = parts[0]
            for suffix in ("_strip", "_rgb"):
                if key.endswith(suffix) and HEX.match(c.get(key[: -len(suffix)], "")):
                    hexval = c[key[: -len(suffix)]]
                    return hexval[1:] if suffix == "_strip" else ",".join(
                        str(int(hexval[i:i + 2], 16)) for i in (1, 3, 5))
            return c.get(key, m.group(0))
        fn = parts[0]
        if fn in ("mix", "mix_strip", "mix_rgb") and len(parts) == 4:
            value = mix(c.get(parts[1], parts[1]), c.get(parts[2], parts[2]), parts[3])
            if fn == "mix_strip":
                return value[1:]
            if fn == "mix_rgb":
                return ",".join(str(int(value[i:i + 2], 16)) for i in (1, 3, 5))
            return value
        if fn == "hypr_gradient" and len(parts) >= 2:
            return hypr_gradient(c, parts[1], " ".join(parts[2:]))
        return m.group(0)

    return re.sub(r"\{\{\s*(.+?)\s*\}\}", sub, text)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 2:
        sys.exit(__doc__)
    theme, out = Path(args[0]), Path(args[1])
    allowed = UNTRUSTED_OVERRIDES if "--untrusted" in sys.argv else TRUSTED_OVERRIDES

    colors = resolve(parse_colors(theme / "colors.toml"))
    out.mkdir(parents=True, exist_ok=True)

    for template in sorted(TEMPLATE_DIR.glob("*.tpl")):
        name = template.name[: -len(".tpl")]
        shipped = theme / name
        if name in allowed and shipped.is_file():
            shutil.copyfile(shipped, out / name)
        else:
            (out / name).write_text(render(template.read_text(), colors))

    shutil.copyfile(theme / "colors.toml", out / "colors.toml")
    (out / "mode").write_text(colors["mode"] + "\n")
    for extra in ("icons.theme", "preview.png"):
        if (theme / extra).is_file():
            shutil.copyfile(theme / extra, out / extra)


if __name__ == "__main__":
    main()
