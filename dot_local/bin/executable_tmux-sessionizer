#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Silence permission errors (e.g. root-owned docker volumes) and dedupe
    # (~/.local/share/chezmoi is found via both search roots).
    selected=$(find ~/ ~/.local/share/chezmoi -mindepth 1 -maxdepth 6 \
        -path "$HOME/.cache" -prune -o -name ".git" -printf '%h\n' 2>/dev/null |
        sort -u | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr .: __)

# Create the session only if it doesn't exist yet (this also starts the server if needed).
if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$selected_name"
else
    tmux attach-session -t "=$selected_name"
fi
