#!/bin/bash
# Run a borg backup now. Goes through borg-backup-run (installed by chezmoi with
# the backup timer), so the result also shows in waybar.

runner=/usr/local/bin/borg-backup-run
if [[ ! -x $runner ]]; then
  echo "$runner is missing: run chezmoi apply (with backup = true) first" >&2
  exit 1
fi

case ${1:-} in
  nas|storagebox) sudo "$runner" "$1" ;;
  # One after the other: the runner allows one run at a time.
  both) sudo "$runner" storagebox nas ;;
  *)
    echo "Usage: $0 {nas|storagebox|both}"
    exit 1
    ;;
esac
