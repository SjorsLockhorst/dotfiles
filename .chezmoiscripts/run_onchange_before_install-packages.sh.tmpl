{{ if (eq .chezmoi.osRelease.id "debian") -}}

#!/bin/sh
# Add brave browser gpg
{{ if .gui_packages -}}
sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main"|sudo tee /etc/apt/sources.list.d/brave-browser-release.list
{{ end -}}

# Install packages needed for all
sudo apt-get update
sudo apt-get install -y {{ $packages | join " " }}

{{ if .gui_packages -}}
sudo apt-get install -y {{ $gui_packages | join " " }}
{{ end -}}

{{ if .zsh -}}
sudo apt-get install -y {{ $zsh | join " " }}
{{ end -}}

{{ if .plasma_i3 -}}
sudo apt-get install -y {{ $plasma_i3 | join " " }}
{{ end -}}

{{ if .latex -}}
wget -qO- https://raw.githubusercontent.com/retorquere/zotero-deb/master/install.sh | sudo bash
sudo apt update
sudo apt-get install -y {{ $latex | join " " }}
{{ end -}}

{{ if .backup -}}
sudo apt-get install -y {{ $backup | join " " }}
{{ end -}}

{{ end -}}

{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{ end -}}

{{ if (eq .chezmoi.osRelease.id "arch") -}}
#!/bin/bash
set -euo pipefail

sudo pacman -S --noconfirm --needed {{ $packagesArch | join " " }}

{{ if .backup -}}
sudo pacman -S --noconfirm --needed {{ $backup | join " " }}
{{ end -}}

{{ if .nvim -}}
sudo pacman -S --noconfirm --needed {{ $nvimArch | join " " }}
{{ end -}}

{{ if .zsh -}}
sudo pacman -S --noconfirm --needed {{ $zsh | join " " }}
{{ end -}}

{{ if .hyprland -}}
sudo pacman -S --noconfirm --needed {{ $hyprland | join " " }}
{{ end -}}

# Last and not fatal: AUR sources live on third-party hosts that can be down,
# which should not stop the rest of the dotfiles from being applied.
{{ $aur := $packagesAUR -}}
{{ if .nvim }}{{ $aur = concat $aur $nvimAUR }}{{ end -}}
{{ if .hyprland }}{{ $aur = concat $aur $hyprlandAUR }}{{ end -}}
yay -S --noconfirm --needed {{ $aur | join " " }} \
    || echo "WARNING: installing AUR packages failed, rerun: yay -S {{ $aur | join " " }}" >&2

{{ end -}}
