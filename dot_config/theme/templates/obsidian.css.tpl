/* Generated by theme-render from ~/.config/theme/templates/obsidian.css.tpl
 * theme-set installs this into every vault as the "Omarchy" Obsidian theme
 * (.obsidian/themes/Omarchy/theme.css), like omarchy's own obsidian.css.tpl.
 * Applies in both Obsidian modes, so the colours always match the desktop theme;
 * set Appearance > Base color scheme to "Adapt to system" to get the mode too. */
.theme-dark,
.theme-light {
    /* Obsidian's grey scale, from background (00) to foreground (100) */
    --color-base-00: {{ background }};
    --color-base-05: {{ mix background foreground 2% }};
    --color-base-10: {{ mix background foreground 4% }};
    --color-base-20: {{ mix background foreground 6% }};
    --color-base-25: {{ mix background foreground 9% }};
    --color-base-30: {{ mix background foreground 14% }};
    --color-base-35: {{ mix background foreground 19% }};
    --color-base-40: {{ mix background foreground 30% }};
    --color-base-50: {{ mix background foreground 38% }};
    --color-base-60: {{ mix background foreground 62% }};
    --color-base-70: {{ mix background foreground 76% }};
    --color-base-100: {{ foreground }};

    --color-red: {{ red }};
    --color-red-rgb: {{ red_rgb }};
    --color-orange: {{ orange }};
    --color-orange-rgb: {{ orange_rgb }};
    --color-yellow: {{ yellow }};
    --color-yellow-rgb: {{ yellow_rgb }};
    --color-green: {{ green }};
    --color-green-rgb: {{ green_rgb }};
    --color-cyan: {{ cyan }};
    --color-cyan-rgb: {{ cyan_rgb }};
    --color-blue: {{ blue }};
    --color-blue-rgb: {{ blue_rgb }};
    --color-purple: {{ magenta }};
    --color-purple-rgb: {{ magenta_rgb }};
    --color-pink: {{ bright_magenta }};
    --color-pink-rgb: {{ bright_magenta_rgb }};

    --color-accent: {{ accent }};
    --color-accent-1: {{ mix accent foreground 15% }};
    --color-accent-2: {{ mix accent foreground 30% }};
    --text-accent: {{ accent }};
    --text-accent-hover: {{ mix accent foreground 15% }};
    --interactive-accent: {{ accent }};
    --interactive-accent-hover: {{ mix accent foreground 15% }};
    --text-on-accent: {{ background }};
    --text-on-accent-inverted: {{ foreground }};

    --text-selection: {{ mix background accent 30% }};
    --text-highlight-bg: rgba({{ yellow_rgb }}, 0.35);
    --caret-color: {{ cursor }};

    /* From omarchy: coloured headings, links, code, tags and graph */
    --h1-color: {{ red }};
    --h2-color: {{ green }};
    --h3-color: {{ yellow }};
    --h4-color: {{ blue }};
    --h5-color: {{ magenta }};
    --h6-color: {{ magenta }};
    --link-color: {{ blue }};
    --link-external-color: {{ blue }};
    --code-normal: {{ cyan }};
    --text-error: {{ red }};
    --text-success: {{ green }};
    --tag-color: {{ cyan }};
    --tag-background: rgba({{ cyan_rgb }}, 0.15);
    --graph-line: {{ muted }};
    --graph-node: {{ accent }};
    --graph-node-focused: {{ blue }};
    --graph-node-tag: {{ cyan }};
    --graph-node-attachment: {{ green }};
}

.markdown-rendered code {
    color: var(--code-normal);
}

.markdown-rendered blockquote {
    border-left-color: {{ accent }};
}

.workspace-leaf.mod-active .workspace-leaf-header-title,
.nav-file-title.is-active,
.search-result-file-title {
    color: var(--interactive-accent);
}
