# Generated by theme-render from ~/.config/theme/templates/tmux.conf.tpl
# Fills the catppuccin/tmux plugin's colour slots from the active theme
set -g @thm_bg "{{ background }}"
set -g @thm_fg "{{ foreground }}"
set -g @thm_rosewater "{{ bright_foreground }}"
set -g @thm_flamingo "{{ bright_red }}"
set -g @thm_pink "{{ bright_magenta }}"
set -g @thm_mauve "{{ magenta }}"
set -g @thm_red "{{ red }}"
set -g @thm_maroon "{{ bright_red }}"
set -g @thm_peach "{{ orange }}"
set -g @thm_yellow "{{ yellow }}"
set -g @thm_green "{{ green }}"
set -g @thm_teal "{{ cyan }}"
set -g @thm_sky "{{ bright_cyan }}"
set -g @thm_sapphire "{{ bright_blue }}"
set -g @thm_blue "{{ blue }}"
set -g @thm_lavender "{{ accent }}"
set -g @thm_subtext_1 "{{ light_foreground }}"
set -g @thm_subtext_0 "{{ dark_foreground }}"
set -g @thm_overlay_2 "{{ mix muted foreground 40% }}"
set -g @thm_overlay_1 "{{ mix muted foreground 20% }}"
set -g @thm_overlay_0 "{{ muted }}"
set -g @thm_surface_2 "{{ mix selection muted 50% }}"
set -g @thm_surface_1 "{{ selection }}"
set -g @thm_surface_0 "{{ lighter_background }}"
set -g @thm_mantle "{{ dark_background }}"
set -g @thm_crust "{{ darker_background }}"
