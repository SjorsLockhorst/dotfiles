// -*- mode: jsonc -*-
// Two bars: compact on the laptop screen (eDP-1), full on every other monitor.
// Modules are defined once in modules.json; colours come from the theme (style.css).
[
    {
        "layer": "top",
        "height": 40,
        "spacing": 0,
        "include": [
            "~/.config/waybar/modules.json"
        ],
        "name": "compact",
        "output": "eDP-1",
        "modules-left": [
            "hyprland/workspaces",
            "mpris#compact"
        ],
        "modules-center": [
            "group/time-compact"
        ],
        "modules-right": [
            "group/status",
            "group/controls",
            "group/system-compact"
        ]
    },
    {
        "layer": "top",
        "height": 40,
        "spacing": 0,
        "include": [
            "~/.config/waybar/modules.json"
        ],
        "name": "full",
        "output": "!eDP-1",
        "modules-left": [
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "group/media",
            "group/time-full"
        ],
        "modules-right": [
            "group/hardware",
            "group/controls",
            "group/system-full"
        ]
    }
]
