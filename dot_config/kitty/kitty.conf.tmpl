font_family      Firacode Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
clipboard_control write-clipboard write-primary no-append

# Slight transparency (only applies to cells using the default background,
# so tmux panes stay transparent as long as they don't paint a background)
background_opacity 0.92
dynamic_background_opacity yes


# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Colours come from the active theme (theme-set swaps this file and reloads kitty)
include {{ .chezmoi.homeDir }}/.local/state/theme/current/kitty.conf
